# Optional local file. Without a local .env, the parent .env is selected.
# Phase 1 calculations need no key. Direct API reviews use gpt-6-luna.
OPENAI_API_KEY=your_openai_api_key_here

# Optional bounded Phase 2 settings (shown at their defaults).
# REVIEW_MAX_MODEL_REQUESTS=12
# REVIEW_MAX_REQUESTS_PER_AGENT=6
# REVIEW_MAX_TOOL_CALLS_PER_AGENT=16
# REVIEW_MAX_OUTPUT_TOKENS=3600
# REVIEW_MAX_REQUEST_BYTES=80000
# REVIEW_MAX_REPORTED_TOKENS=80000
# REVIEW_MAX_RETRIES=1
# REVIEW_RETRY_DELAY_SECONDS=0.5
# REVIEW_REQUEST_TIMEOUT_SECONDS=45
# REVIEW_REVIEW_TIMEOUT_SECONDS=180
# REVIEW_MAX_NARRATIVE_CHARS=20000
# REVIEW_MAX_DOCUMENT_CHARS=12000
# REVIEW_MAX_TOOL_OUTPUT_BYTES=24000

# Phase 3 browser application. Process environment overrides the selected file.
# Local defaults enable live reviews only when a server key is configured.
# WEB_PUBLIC_MODE=false
# WEB_LIVE_ENABLED=true
# WEB_ORIGIN=http://127.0.0.1:8000
# WEB_DAILY_REVIEWS=6
# WEB_SESSION_REVIEWS=2
# WEB_RETENTION_HOURS=24
# WEB_ACCESS_CODE=replace_with_a_private_random_code_at_least_16_characters
# Public mode requires HTTPS WEB_ORIGIN; live public mode also requires the code.
# Use a persistent /app/runtime volume for public live reviews. See docs/deployment.md.
